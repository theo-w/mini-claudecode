        "count": 5
      },
      {
        "type": "tool_paths_covered",
        "name": "read_file",
        "paths": [
          "checkpoints-paged.log"
        ]
      },
      {
        "type": "tool_not_called",
        "name": "grep"
      },
      {
        "type": "model_call_count_at_least",
        "count": 5
      },
      {
        "type": "compaction_count_at_least",
        "count": 1
      },
      {
        "type": "output_equals_normalized",
        "text": "K7Q-A19|P2V-D47"
      }
    ],
    "max_steps": 8
  },
