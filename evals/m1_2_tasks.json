    "setup": {
      "checkpoints-paged.log": {
        "head_lines": [
          "2026-10-28 INFO checkpoint page start",
          "CHECKPOINT: K7Q-A19"
        ],
        "repeat_lines": [
          "2026-10-28 INFO checkpoint sweep retained stable worker state"
        ],
        "repeat": 80,
        "tail_lines": [
          "2026-10-28 INFO final checkpoint page",
          "CHECKPOINT: P2V-D47",
          "2026-10-28 INFO checkpoint sweep complete"
        ]
      }
    },
    "checks": [
      {
        "type": "tool_succeeded",
        "name": "read_file"
      },
      {
        "type": "tool_call_count_at_least",
