  {
    "id": "m1_2_multi_file_evidence",
    "group": "multi_file",
    "tags": [
      "multiple_sources",
      "old_evidence"
    ],
    "prompt": "必须为每个文件单独调用 read_file，不得使用 grep，不要根据文件名、目录结构或示例猜测。分别读取 fragments/alpha.txt、fragments/beta.txt 和 fragments/gamma.txt；文件较长时按 next_start_line 继续读取，直到 file_has_more=false。提取每个文件里的 SEGMENT 值。最后严格按 alpha、beta、gamma 的顺序，用连字符连接三个值后原样输出。",
    "setup": {
      "fragments/alpha.txt": {
        "repeat_lines": [
          "alpha noise line 001",
          "alpha noise line 002",
          "alpha noise line 003",
          "alpha noise line 004"
        ],
        "repeat": 12,
        "tail_lines": [
          "SEGMENT: M12-ALPHA"
        ]
      },
      "fragments/beta.txt": {
        "repeat_lines": [
          "beta noise line 001",
          "beta noise line 002",
          "beta noise line 003",
          "beta noise line 004"
        ],
        "repeat": 12,
        "tail_lines": [
          "SEGMENT: M12-BETA"
        ]
      },
      "fragments/gamma.txt": {
        "repeat_lines": [
          "gamma noise line 001",
          "gamma noise line 002",
          "gamma noise line 003",
          "gamma noise line 004"
        ],
        "repeat": 12,
        "tail_lines": [
          "SEGMENT: M12-GAMMA"
        ]
      }
    },
    "checks": [
      {
        "type": "tool_succeeded",
        "name": "read_file"
      },
      {
        "type": "tool_call_count_at_least",
        "name": "read_file",
        "count": 6
      },
      {
        "type": "compaction_count_at_least",
        "count": 1
      },
      {
        "type": "output_contains",
        "text": "M12-ALPHA-M12-BETA-M12-GAMMA"
      }
    ],
    "max_steps": 8
  },
  {
