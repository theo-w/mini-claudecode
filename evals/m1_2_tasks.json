[
  {
    "id": "m1_2_value_retention",
    "group": "retention",
    "tags": [
      "exact_value",
      "pagination"
    ],
    "prompt": "读取 audits-m12.log，必须使用 read_file，不得使用 grep；文件较长，如果一次读取没有覆盖全文，按 next_start_line 继续读取，直到覆盖全文，不要猜测。最后原样报告 ACCESS_CODE 的完整值。",
    "setup": {
      "audits-m12.log": {
        "repeat_lines": [
          "2026-10-28 INFO scheduler tick completed",
          "2026-10-28 INFO worker heartbeat healthy",
          "2026-10-28 DEBUG cache lookup finished",
          "2026-10-28 WARN retryable timeout observed"
        ],
        "repeat": 24,
        "tail_lines": [
          "2026-10-28 ERROR calibration validation failed",
          "ACCESS_CODE: M12-VALUE-7319",
          "2026-10-28 INFO graceful shutdown"
        ]
      }
    },
    "checks": [
      {
        "type": "tool_succeeded",
        "name": "read_file"
      },
      {
        "type": "tool_call_count_at_least",
        "name": "read_file",
        "count": 2
      },
      {
        "type": "tool_not_called",
        "name": "grep"
      },
      {
        "type": "compaction_count_at_least",
        "count": 1
      },
      {
        "type": "output_contains",
        "text": "M12-VALUE-7319"
      }
    ],
    "max_steps": 10
  },
  {
