[
  {
    "id": "m1_scan_long_file_01",
    "group": "scan",
    "prompt": "读取 audits-01.log，找到 ACCESS_CODE 的值并原样报告。文件较长，必须基于真实 observation；如果一次读取没有覆盖全文，按 next_start_line 继续读取，不要猜测。",
    "setup": {
      "audits-01.log": {
        "repeat_lines": [
          "2026-10-28 INFO scheduler tick completed",
          "2026-10-28 INFO worker heartbeat healthy",
          "2026-10-28 DEBUG cache lookup finished",
          "2026-10-28 WARN retryable timeout observed"
        ],
        "repeat": 60,
        "tail_lines": [
          "2026-10-28 ERROR calibration validation failed",
          "ACCESS_CODE: ORBIT-7319",
          "2026-10-28 INFO graceful shutdown"
        ]
      }
    },
    "checks": [
      {
        "type": "tool_call_count_at_least",
        "name": "read_file",
        "count": 2
      },
      {
        "type": "tool_not_called",
        "name": "grep"
      },
      {
        "type": "tool_succeeded",
        "name": "read_file"
      },
      {
        "type": "output_contains",
        "text": "ORBIT-7319"
      }
    ],
    "max_steps": 10
  },
